<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sơ Đồ Chỗ Ngồi - Lớp 10A15</title>
    <!-- Font Inter cho giao diện tiếng Việt sắc nét -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- SheetJS (xlsx) để đọc và xuất file Excel DS TKMK.xlsx -->
    <script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                }
            }
        }
    </script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col selection:bg-indigo-100 selection:text-indigo-700">

    <!-- ==================== THANH ĐIỀU HƯỚNG (HEADER) ==================== -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap items-center justify-between gap-3">
            <!-- Logo & Tiêu đề lớp -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 to-blue-500 text-white flex items-center justify-center font-extrabold text-sm shadow-md shadow-indigo-200">
                    10A15
                </div>
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1 class="text-lg sm:text-xl font-bold text-slate-900 leading-tight">Sơ Đồ Chỗ Ngồi Lớp 10A15</h1>
                        <span id="realtimeBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                            Đang kết nối...
                        </span>
                    </div>
                    <p class="text-xs text-slate-500">6 hàng (A–F) • 4 cột (1–4) • 24 bàn đôi (48 chỗ)</p>
                </div>
            </div>

            <!-- Trạng thái đăng nhập & Nút chức năng -->
            <div id="headerActions" class="flex flex-wrap items-center gap-2">
                <!-- Nội dung được render tự động bằng JavaScript -->
            </div>
        </div>
    </header>

    <!-- ==================== NỘI DUNG CHÍNH ==================== -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Thông báo hướng dẫn nhập file Excel nếu đang dùng dữ liệu mẫu -->
        <div id="sampleDataBanner" class="bg-amber-50 border border-amber-200 rounded-2xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-sm">
            <div class="flex items-start gap-3">
                <div class="p-2 bg-amber-100 text-amber-700 rounded-xl shrink-0">
                    <i data-lucide="file-spreadsheet" class="w-5 h-5"></i>
                </div>
                <div class="text-sm text-amber-900">
                    <p class="font-semibold">Đang sử dụng danh sách học sinh mẫu (48 học sinh).</p>
                    <p class="text-amber-700 mt-0.5">Quản trị viên hãy tải lên file mới nhất <strong>DS TKMK_2.xlsx</strong> (Cột A: Tài khoản, Cột C: Mật khẩu) để đồng bộ ngay cho toàn bộ lớp 10A15.</p>
                </div>
            </div>
            <button onclick="handleQuickImportClick()" class="shrink-0 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold rounded-xl transition shadow-sm flex items-center gap-2 cursor-pointer">
                <i data-lucide="upload" class="w-4 h-4"></i>
                <span>Nhập DS TKMK_2.xlsx</span>
            </button>
        </div>

        <!-- ==================== BẢNG ĐIỀU KHIỂN QUẢN TRỊ VIÊN ==================== -->
        <section id="adminPanel" class="hidden bg-gradient-to-r from-slate-900 to-indigo-950 text-white rounded-2xl p-5 shadow-lg">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-200 text-xs font-semibold mb-2">
                        <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                        <span>Chế độ Quản trị viên (nguyenvietha)</span>
                    </div>
                    <h2 class="text-lg font-bold">Công cụ quản lý lớp 10A15</h2>
                    <p class="text-xs sm:text-sm text-slate-300 mt-0.5">Nhấn vào <strong>ghế trống</strong> để đăng ký trước cho học sinh, hoặc nhấn vào <strong>ghế đã có người</strong> để hủy đăng ký.</p>
                </div>

                <div class="flex flex-wrap items-center gap-2.5">
                    <!-- Input ẩn để chọn file Excel -->
                    <input type="file" id="excelFileInput" accept=".xlsx,.xls,.csv" class="hidden" onchange="handleExcelUpload(event)">
                    
                    <button onclick="document.getElementById('excelFileInput').click()" class="px-3.5 py-2.5 bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-semibold rounded-xl transition flex items-center gap-2 shadow-sm cursor-pointer">
                        <i data-lucide="file-up" class="w-4 h-4"></i>
                        <span>Nhập Excel (DS TKMK_2)</span>
                    </button>

                    <button onclick="openStudentListModal()" class="px-3.5 py-2.5 bg-white/10 hover:bg-white/20 text-white text-sm font-semibold rounded-xl transition flex items-center gap-2 border border-white/15 cursor-pointer">
                        <i data-lucide="users" class="w-4 h-4"></i>
                        <span>Danh sách HS (<span id="adminStudentCount">0</span>)</span>
                    </button>

                    <button onclick="exportSeatingToExcel()" class="px-3.5 py-2.5 bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-semibold rounded-xl transition flex items-center gap-2 shadow-sm cursor-pointer">
                        <i data-lucide="download" class="w-4 h-4"></i>
                        <span>Xuất sơ đồ Excel</span>
                    </button>

                    <button onclick="confirmClearAllSeats()" class="px-3.5 py-2.5 bg-rose-500/20 hover:bg-rose-600 text-rose-200 hover:text-white text-sm font-semibold rounded-xl transition flex items-center gap-2 border border-rose-400/30 cursor-pointer">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                        <span>Xóa toàn bộ</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- ==================== THỐNG KÊ & CHÚ THÍCH ==================== -->
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center shrink-0">
                    <i data-lucide="armchair" class="w-5 h-5"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500">Tổng số chỗ ngồi</p>
                    <p id="statTotal" class="text-xl font-extrabold text-slate-900">48</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                    <i data-lucide="user-check" class="w-5 h-5"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500">Đã đăng ký</p>
                    <p id="statOccupied" class="text-xl font-extrabold text-indigo-600">0</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                    <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500">Còn trống</p>
                    <p id="statAvailable" class="text-xl font-extrabold text-emerald-600">48</p>
                </div>
            </div>

            <div class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm flex items-center gap-3.5">
                <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0">
                    <i data-lucide="graduation-cap" class="w-5 h-5"></i>
                </div>
                <div>
                    <p class="text-xs font-medium text-slate-500">Tài khoản HS</p>
                    <p id="statStudents" class="text-xl font-extrabold text-blue-600">0</p>
                </div>
            </div>
        </section>

        <!-- Chú thích màu sắc -->
        <div class="flex flex-wrap items-center justify-between gap-3 bg-white px-4 py-3 rounded-2xl border border-slate-200 shadow-sm text-xs sm:text-sm">
            <div class="flex flex-wrap items-center gap-4">
                <span class="flex items-center gap-2 font-medium text-slate-600">
                    <span class="w-4 h-4 rounded-md bg-white border-2 border-dashed border-slate-300 inline-block"></span>
                    Ghế trống
                </span>
                <span class="flex items-center gap-2 font-medium text-slate-600">
                    <span class="w-4 h-4 rounded-md bg-indigo-100 border border-indigo-300 inline-block"></span>
                    Đã có học sinh
                </span>
                <span class="flex items-center gap-2 font-medium text-slate-600">
                    <span class="w-4 h-4 rounded-md bg-emerald-500 border border-emerald-600 inline-block"></span>
                    Chỗ ngồi của bạn
                </span>
            </div>
            <div id="userHintText" class="text-slate-500 font-medium">
                Vui lòng đăng nhập để chọn chỗ ngồi.
            </div>
        </div>

        <!-- ==================== SƠ ĐỒ LỚP HỌC (BẢNG CHỌN CHỖ) ==================== -->
        <section class="bg-white rounded-3xl border border-slate-200 shadow-sm p-4 sm:p-6 overflow-x-auto">
            <div class="min-w-[820px]">
                <!-- Bảng đen & Bục giảng -->
                <div class="mb-7 flex flex-col items-center">
                    <div class="w-2/3 max-w-xl bg-gradient-to-b from-emerald-800 to-emerald-900 text-emerald-50 py-3 px-6 rounded-2xl text-center font-bold tracking-wider uppercase text-sm shadow-md border-4 border-amber-800/70">
                        Bảng Đen • Bục Giảng (Phía Trước Lớp)
                    </div>
                    <div class="mt-2 text-xs text-slate-400 font-medium">Hàng A gần bảng nhất • Hàng F cuối lớp</div>
                </div>

                <!-- Tiêu đề các cột (1, 2, 3, 4) -->
                <div class="grid grid-cols-[44px_1fr_1fr_24px_1fr_1fr] gap-3 mb-3 px-1">
                    <div></div>
                    <div class="text-center text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-100 py-1.5 rounded-lg">Cột 1 (Tổ 1)</div>
                    <div class="text-center text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-100 py-1.5 rounded-lg">Cột 2 (Tổ 2)</div>
                    <div class="text-center text-[10px] font-semibold text-slate-300 flex items-center justify-center">Lối đi</div>
                    <div class="text-center text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-100 py-1.5 rounded-lg">Cột 3 (Tổ 3)</div>
                    <div class="text-center text-xs font-bold uppercase tracking-wider text-slate-500 bg-slate-100 py-1.5 rounded-lg">Cột 4 (Tổ 4)</div>
                </div>

                <!-- Lưới 6 hàng A-F x 4 cột bàn đôi -->
                <div id="seatingGrid" class="space-y-3.5">
                    <!-- Nội dung sơ đồ được render bằng JavaScript -->
                </div>
            </div>
        </section>
    </main>

    <!-- ==================== FOOTER ==================== -->
    <footer class="bg-white border-t border-slate-200 py-4 text-center text-xs text-slate-500 mt-auto">
        Hệ thống đăng ký chỗ ngồi lớp <strong>10A15</strong> • Thiết kế tối ưu cho máy tính và điện thoại
    </footer>

    <!-- ==================== CÁC MODAL TƯƠNG TÁC ==================== -->

    <!-- 1. Modal Đăng nhập Học sinh -->
    <div id="studentLoginModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 animate-[fadeIn_0.15s_ease-out]">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center">
                        <i data-lucide="user-circle" class="w-5 h-5"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900">Đăng nhập Học sinh</h3>
                </div>
                <button onclick="closeModal('studentLoginModal')" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl transition cursor-pointer">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <p class="text-xs text-slate-500 mb-4 bg-slate-50 p-3 rounded-xl border border-slate-200">
                Nhập <strong>Tài khoản</strong> (Cột A trong file <strong>DS TKMK_2.xlsx</strong>) và <strong>Mật khẩu</strong> tương ứng ở Cột C.
            </p>

            <form onsubmit="handleStudentLogin(event)" class="space-y-4">
                <div>
                    <label for="studentUsername" class="block text-sm font-semibold text-slate-700 mb-1.5">Tài khoản (Cột A)</label>
                    <input type="text" id="studentUsername" required placeholder="Nhập tài khoản ở cột A..."
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition text-sm">
                </div>
                <div>
                    <label for="studentPassword" class="block text-sm font-semibold text-slate-700 mb-1.5">Mật khẩu (Cột C)</label>
                    <input type="password" id="studentPassword" required placeholder="Nhập mật khẩu ở cột C..."
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition text-sm">
                </div>

                <div id="studentLoginError" class="hidden text-xs font-medium text-rose-600 bg-rose-50 border border-rose-200 p-3 rounded-xl"></div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" onclick="closeModal('studentLoginModal')" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition cursor-pointer">
                        Hủy
                    </button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition cursor-pointer">
                        Đăng nhập
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 2. Modal Đăng nhập Quản trị viên -->
    <div id="adminLoginModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center">
                        <i data-lucide="shield" class="w-5 h-5"></i>
                    </div>
                    <h3 class="text-lg font-bold text-slate-900">Đăng nhập Quản trị viên</h3>
                </div>
                <button onclick="closeModal('adminLoginModal')" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl transition cursor-pointer">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <form onsubmit="handleAdminLogin(event)" class="space-y-4">
                <div>
                    <label for="adminUsername" class="block text-sm font-semibold text-slate-700 mb-1.5">Tài khoản quản trị</label>
                    <input type="text" id="adminUsername" required placeholder="Nhập tài khoản..."
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-slate-800 focus:ring-2 focus:ring-slate-200 outline-none transition text-sm">
                </div>
                <div>
                    <label for="adminPassword" class="block text-sm font-semibold text-slate-700 mb-1.5">Mật khẩu</label>
                    <input type="password" id="adminPassword" required placeholder="Nhập mật khẩu..."
                        class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-slate-800 focus:ring-2 focus:ring-slate-200 outline-none transition text-sm">
                </div>

                <div id="adminLoginError" class="hidden text-xs font-medium text-rose-600 bg-rose-50 border border-rose-200 p-3 rounded-xl"></div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" onclick="closeModal('adminLoginModal')" class="px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition cursor-pointer">
                        Hủy
                    </button>
                    <button type="submit" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 shadow-sm transition cursor-pointer">
                        Xác nhận
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- 3. Modal Quản trị viên đăng ký trước cho học sinh -->
    <div id="adminAssignModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 flex flex-col max-h-[85vh]">
            <div class="flex items-center justify-between mb-3">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Đăng ký trước cho học sinh</h3>
                    <p id="assignSeatLabel" class="text-sm font-semibold text-indigo-600 mt-0.5">Vị trí: Bàn A1 - Ghế 1</p>
                </div>
                <button onclick="closeModal('adminAssignModal')" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl transition cursor-pointer">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Ô tìm kiếm học sinh -->
            <div class="relative mb-3">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="text" id="assignSearchInput" oninput="renderAdminAssignList()" placeholder="Tìm kiếm họ tên học sinh chưa có chỗ..."
                    class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-300 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none text-sm">
            </div>

            <!-- Danh sách học sinh chưa có chỗ -->
            <div id="adminAssignList" class="flex-1 overflow-y-auto space-y-1.5 pr-1 min-h-[180px] max-h-[300px] border border-slate-100 rounded-2xl p-2 bg-slate-50">
                <!-- Render tự động -->
            </div>

            <!-- Hoặc nhập tên thủ công -->
            <div class="mt-4 pt-4 border-t border-slate-200">
                <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Hoặc nhập nhanh tên học sinh ngoài danh sách</label>
                <div class="flex gap-2">
                    <input type="text" id="manualStudentName" placeholder="Nhập họ và tên..."
                        class="flex-1 px-3.5 py-2 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none text-sm">
                    <button onclick="assignManualStudent()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-xl transition cursor-pointer shrink-0">
                        Xếp chỗ
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Modal Danh sách học sinh (Dành cho Quản trị viên) -->
    <div id="studentListModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl max-w-3xl w-full p-6 shadow-2xl border border-slate-100 flex flex-col max-h-[88vh]">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Danh sách tài khoản học sinh lớp 10A15</h3>
                    <p id="studentListSubtitle" class="text-xs text-slate-500 mt-0.5">Tổng số: 0 học sinh</p>
                </div>
                <button onclick="closeModal('studentListModal')" class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl transition cursor-pointer">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <div class="flex flex-col sm:flex-row gap-2 mb-3">
                <div class="relative flex-1">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                    <input type="text" id="studentListSearch" oninput="renderStudentListTable()" placeholder="Tìm theo tên hoặc vị trí ghế..."
                        class="w-full pl-10 pr-4 py-2 rounded-xl border border-slate-300 focus:border-indigo-500 outline-none text-sm">
                </div>
                <button onclick="toggleShowPasswords()" id="togglePwdBtn" class="px-3.5 py-2 rounded-xl border border-slate-300 hover:bg-slate-50 text-slate-700 text-xs font-semibold flex items-center justify-center gap-1.5 cursor-pointer">
                    <i data-lucide="eye" class="w-4 h-4"></i>
                    <span>Hiện mật khẩu</span>
                </button>
            </div>

            <div class="flex-1 overflow-y-auto border border-slate-200 rounded-2xl">
                <table class="w-full text-left border-collapse text-sm">
