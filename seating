                    Đóng
                </button>
                <button id="confirmActionBtn" class="px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition cursor-pointer">
                    Đồng ý
                </button>
