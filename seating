    <!-- 5. Modal Xác nhận dùng chung (Thay thế hoàn toàn alert/confirm) -->
    <div id="confirmModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100">
            <div class="flex items-start gap-3.5 mb-4">
                <div id="confirmIconBox" class="w-10 h-10 rounded-2xl bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
                    <i data-lucide="help-circle" class="w-5 h-5"></i>
                </div>
                <div>
                    <h3 id="confirmTitle" class="text-lg font-bold text-slate-900">Xác nhận</h3>
                    <p id="confirmMessage" class="text-sm text-slate-600 mt-1 leading-relaxed"></p>
                </div>
            </div>
            <div class="flex items-center justify-end gap-2 pt-2">
